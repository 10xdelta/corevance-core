COREVANCE_USER=1000
COREVANCE_GROUP=1000
COREVANCE_HIKARI_MINIMUM_IDLE=3
COREVANCE_HIKARI_MAXIMUM_POOL_SIZE=10
COREVANCE_HIKARI_IDLE_TIMEOUT=60000
COREVANCE_HIKARI_CONNECTION_TIMEOUT=20000
COREVANCE_HIKARI_TEST_QUERY=SELECT 1
COREVANCE_HIKARI_AUTO_COMMIT=true
COREVANCE_SERVER_SSL_ENABLED=true
COREVANCE_HIKARI_USERNAME=root
COREVANCE_HIKARI_PASSWORD=skdcnwauicn2ucnaecasdsajdnizucawencascdca
COREVANCE_HIKARI_DS_PROPERTIES_CACHE_PREP_STMTS=true
COREVANCE_HIKARI_DS_PROPERTIES_PREP_STMT_CACHE_SIZE=250
COREVANCE_HIKARI_DS_PROPERTIES_PREP_STMT_CACHE_SQL_LIMIT=2048
COREVANCE_HIKARI_DS_PROPERTIES_USE_SERVER_PREP_STMTS=true
COREVANCE_HIKARI_DS_PROPERTIES_USE_LOCAL_SESSION_STATE=true
COREVANCE_HIKARI_DS_PROPERTIES_REWRITE_BATCHED_STATEMENTS=true
COREVANCE_HIKARI_DS_PROPERTIES_CACHE_RESULT_SET_METADATA=true
COREVANCE_HIKARI_DS_PROPERTIES_CACHE_SERVER_CONFIGURATION=true
COREVANCE_HIKARI_DS_PROPERTIES_ELIDE_SET_AUTO_COMMITS=true
COREVANCE_HIKARI_DS_PROPERTIES_MAINTAIN_TIME_STATS=false
COREVANCE_HIKARI_DS_PROPERTIES_LOG_SLOW_QUERIES=true
COREVANCE_HIKARI_DS_PROPERTIES_DUMP_QUERIES_IN_EXCEPTION=true
# NOTE: env vars prefixed "COREVANCE_DEFAULT_TENANTDB_*" are used to create the default tenant database
COREVANCE_DEFAULT_TENANTDB_CONN_PARAMS=
COREVANCE_DEFAULT_TENANTDB_TIMEZONE=Asia/Kolkata
COREVANCE_DEFAULT_TENANTDB_IDENTIFIER=default
COREVANCE_DEFAULT_TENANTDB_NAME=corevance_default
COREVANCE_DEFAULT_TENANTDB_DESCRIPTION=Default Demo Tenant
COREVANCE_DEFAULT_TENANTDB_HOSTNAME=db
COREVANCE_DEFAULT_TENANTDB_PWD=skdcnwauicn2ucnaecasdsajdnizucawencascdca
COREVANCE_DEFAULT_MASTER_PASSWORD=corevance
COREVANCE_MANAGEMENT_ENDPOINT_WEB_EXPOSURE_INCLUDE=health,info,prometheus
COREVANCE_MANAGEMENT_METRICS_TAGS_APPLICATION=corevance
COREVANCE_REMOTE_JOB_MESSAGE_HANDLER_SPRING_EVENTS_ENABLED=true
COREVANCE_INSECURE_HTTP_CLIENT=true
COREVANCE_CONTENT_FILESYSTEM_ROOT_FOLDER=/tmp
SPRING_PROFILES_ACTIVE=test,diagnostics
OTEL_SERVICE_NAME=corevance
JAVA_TOOL_OPTIONS="-Xmx1G -XX:MinRAMPercentage=25 -XX:MaxRAMPercentage=80 -XX:TieredStopAtLevel=1 -XX:+UseContainerSupport -XX:+UseStringDeduplication -agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:5000 --add-exports=java.naming/com.sun.jndi.ldap=ALL-UNNAMED --add-opens=java.base/java.lang=ALL-UNNAMED --add-opens=java.base/java.lang.invoke=ALL-UNNAMED --add-opens=java.base/java.io=ALL-UNNAMED --add-opens=java.base/java.security=ALL-UNNAMED --add-opens=java.base/java.util=ALL-UNNAMED --add-opens=java.management/javax.management=ALL-UNNAMED --add-opens=java.naming/javax.naming=ALL-UNNAMED"
